# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env
# .env git tarafından yok sayılır (bkz. .gitignore) — asla commit'lemeyin.

# Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co

# Supabase > API Keys > Publishable key (sb_publishable_...)
# Bu anahtar tarayıcıya gider; gitmesi normaldir. Veriyi koruyan şey RLS'tir.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase > API Keys > Secret key (sb_secret_...)
# YALNIZCA SUNUCUDA. Başına NEXT_PUBLIC_ EKLEMEYİN — eklerseniz anahtar
# tarayıcı paketine girer ve RLS'i baypas eden tam yetki herkese açılır.
# Yalnızca app/api/* route'ları tarafından kullanılır.
SUPABASE_SERVICE_ROLE=sb_secret_...
